# Telegram credentials — configure only in Netlify environment variables
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_SESSION=
ADMIN_TELEGRAM_USER_ID=

# Existing PostgreSQL connection
DATABASE_URL=

# Generate long random values; never expose these to the frontend
ADMIN_SETUP_SECRET=
SESSION_ENCRYPTION_KEY=
AUTH_JWT_SECRET=

# Optional private Telegram source identifier, server-side only
TELEGRAM_SOURCE_CHANNEL=

# ─────────────────────────────────────────────────────────────────────────────
# X-Sutra environment variables — set these in the hosting provider only
# (Vercel → Project → Settings → Environment Variables). Never commit real
# values, never put them in the frontend. No BACKEND_URL is needed: the
# frontend calls same-origin /api/... routes in this same deployment.
# ─────────────────────────────────────────────────────────────────────────────

# ── Discord Bot integration (required for uploads) ──────────────────────────
# From the Discord Developer Portal → your bot → Bot → Reset Token.
# Server-side only. Never sent to the browser.
DISCORD_BOT_TOKEN=
# Your Discord server (guild) id. The bot must be installed in this server.
DISCORD_GUILD_ID=
# The channel where uploads are posted. The bot needs View Channel, Send
# Messages, Attach Files, Read Message History (+ Manage Messages for delete).
DISCORD_CHANNEL_ID=
# The Discord user id allowed to perform protected operations (documentation /
# health context). Backend admin actions are authorised by the X-Sutra admin
# password as well.
DISCORD_ADMIN_USER_ID=
# Optional: per-file cap in MB. Discord's no-boost attachment limit is 8.
DISCORD_MAX_UPLOAD_MB=8

# ── Database (required) ─────────────────────────────────────────────────────
# Your existing Neon PostgreSQL connection string. Stores the Discord message
# mapping (xs_discord_media) and transient upload chunks.
DATABASE_URL=

# ── Signing key (required) ──────────────────────────────────────────────────
# Signs the Premium role JWT. Generate a long random value.
AUTH_JWT_SECRET=

# ── Premium admin (existing) ────────────────────────────────────────────────
# Password the admin panel sends for write operations (incl. Discord upload /
# delete). Defaults to admin123 if unset — set a strong value in production.
PREMIUM_ADMIN_PASSWORD=

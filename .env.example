# RedGrab backend environment (Netlify / Vercel functions).
# No BACKEND_URL is needed: the frontend calls same-origin /api/... routes.

# Admin password for the premium catalog API. Defaults to "admin123" when unset.
PREMIUM_ADMIN_PASSWORD=

# Local development only: where the premium catalog JSON and uploaded media live.
# On Netlify/Vercel these are ignored and the platform blob store is used.
PREMIUM_LOCAL_FILE=
PREMIUM_MEDIA_DIR=

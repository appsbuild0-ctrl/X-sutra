# ─────────────────────────────────────────────────────────────────────────────
# X-Sutra environment variables — set these in the hosting provider only
# (Vercel → Project → Settings → Environment Variables). Never commit real
# values. No BACKEND_URL is needed: the frontend calls same-origin /api/...
# routes served by the api/ functions in this same deployment.
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. "Login with Telegram" (required) ──────────────────────────────────────
# From @BotFather: /newbot → the HTTP API token. Server-side only; the browser
# never sees it (the widget only needs the bot's public @username, which the
# backend reads from the Bot API).
TELEGRAM_BOT_TOKEN=

# ── 2. Database (required) ───────────────────────────────────────────────────
# Your existing Neon PostgreSQL connection string (pooled or direct). Holds the
# Telegram accounts, admin ids, uploads and the private-source session.
DATABASE_URL=

# ── 3. Signing key (required) ────────────────────────────────────────────────
# Signs both the X-Sutra user JWT and the owner console token. Generate a long
# random value; rotating it signs everybody out.
AUTH_JWT_SECRET=

# ── 4. Admin bootstrap (optional but recommended once) ───────────────────────
# Comma-separated Telegram user ids that are admins on first run. Find yours by
# messaging @userinfobot. After the first admin logs in, the list is managed in
# Admin Panel → Accounts (stored in xs_admin_telegram_ids).
TELEGRAM_ADMIN_IDS=

# ── 5. Optional tuning ───────────────────────────────────────────────────────
# How many days an X-Sutra session stays valid (default 30)
USER_SESSION_DAYS=30
# How long a Telegram login payload stays acceptable, in seconds (default 3600)
TELEGRAM_AUTH_MAX_AGE=3600
# Maximum size of one admin upload, in MB (default 200)
MAX_UPLOAD_MB=200

# ─────────────────────────────────────────────────────────────────────────────
# Private Telegram source (the owner-only "Source" tab). This is a SEPARATE
# feature from user login: it reads the owner's Telegram channels via MTProto.
# Not required for "Login with Telegram" — leave these empty if you only want
# user authentication and admin uploads.
# ─────────────────────────────────────────────────────────────────────────────
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
ADMIN_TELEGRAM_USER_ID=
# Encrypts the stored MTProto session; rotating it forces one new OTP login.
SESSION_ENCRYPTION_KEY=
# How many days a device stays logged in to the owner Telegram console (default 180)
OWNER_SESSION_DAYS=180
# Optional. The console uses a plain OTP login; keep this only for the CLI.
ADMIN_SETUP_SECRET=
# Optional private Telegram source identifier, server-side only
TELEGRAM_SOURCE_CHANNEL=

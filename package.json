{
  "name": "redgrab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "RedGrab — Download GIFs, images and videos from RedGifs. Browse, search, save and play clips in HD.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:drop": "tsc -b && vite build --mode drop --outDir dist-drop && node scripts/write-drop-redirects.mjs",
    "build:artifacts": "npm run build:drop && node scripts/build-release-artifacts.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "check": "tsc --noEmit",
    "cap:sync": "npm run build && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@capacitor/filesystem": "^6.0.3",
    "jose": "^6.2.10",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}

# Telegram credentials — configure only in the hosting provider (Vercel/Netlify)
# No BACKEND_URL is needed: the frontend calls same-origin /api/... routes.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_SESSION=
ADMIN_TELEGRAM_USER_ID=

# Existing PostgreSQL connection. Required: the one-time Telegram login is
# stored here, so without it the owner would have to log in again every time.
DATABASE_URL=

# Generate long random values; never expose these to the frontend.
# Rotating AUTH_JWT_SECRET also revokes every saved owner console session.
SESSION_ENCRYPTION_KEY=
AUTH_JWT_SECRET=

# Optional. The Telegram console now uses a simple OTP login and no longer
# needs a setup secret; keep this set only if you also use the trusted CLI.
ADMIN_SETUP_SECRET=

# How many days a device stays logged in to the owner Telegram console (default 180)
OWNER_SESSION_DAYS=180

# Optional private Telegram source identifier, server-side only
TELEGRAM_SOURCE_CHANNEL=

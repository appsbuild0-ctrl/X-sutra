# Telegram credentials — configure only in the hosting provider (Vercel/Netlify)
# No BACKEND_URL is needed: the frontend calls same-origin /api/... routes.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_SESSION=
ADMIN_TELEGRAM_USER_ID=

# Existing PostgreSQL connection. Required: the one-time Telegram login is
# stored here, so without it the owner would have to log in again every time.
DATABASE_URL=

# Generate long random values; never expose these to the frontend.
# Rotating AUTH_JWT_SECRET also revokes every saved owner console session.
SESSION_ENCRYPTION_KEY=
AUTH_JWT_SECRET=

# Optional. The Telegram console now uses a simple OTP login and no longer
# needs a setup secret; keep this set only if you also use the trusted CLI.
ADMIN_SETUP_SECRET=

# How many days a device stays logged in to the owner Telegram console (default 180)
OWNER_SESSION_DAYS=180

# Optional private Telegram source identifier, server-side only
TELEGRAM_SOURCE_CHANNEL=

# ─── Discord (Premium "real Discord" import) ───
# Bot token from the Discord Developer Portal. Server-side only — it is never
# sent to the browser. The bot must be a member of DISCORD_GUILD_ID with
# View Channel + Read Message History (Attach Files + Send Messages for uploads).
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Fallback channel used when the admin does not pick one in the console.
DISCORD_CHANNEL_ID=
DISCORD_ADMIN_USER_ID=

# Admin password accepted by the Discord admin endpoints. Defaults to the same
# value as PREMIUM_ADMIN_PASSWORD (admin123) — set a long random value.
# ADMIN_PASSWORD=

# Optional: how many milliseconds one sync request may work before it answers
# with `partial` plus the channel ids it did not reach (default 8000).
# DISCORD_SYNC_BUDGET_MS=8000

# Optional: mirror imported attachments into the premium file store instead of
# streaming them from the Discord CDN. Off by default — Discord stays the media
# source and nothing is stored twice.
# DISCORD_STORE_ATTACHMENTS=false
